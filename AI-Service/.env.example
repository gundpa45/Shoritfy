# Shortify AI Service Environment Variables
# Copy this file to .env and fill in your values

# Required: Google Gemini API Key
# Get yours free at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Port (default 8000, cloud platforms inject this)
PORT=8000

# Optional: Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3200,http://localhost:5173

# Auto-injected by Render — DO NOT set manually
# Used for keep-alive self-ping to prevent free tier sleep
# RENDER_EXTERNAL_URL=https://your-ai-service.onrender.com

